# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox) ---
# REST API base URL; the sandbox is the only environment this project has been tested against
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# One sandbox REST app per shop; each app can only capture or void its own merchant's authorizations
PAYPAL_TECHMART_CLIENT_ID=your-techmart-app-client-id
PAYPAL_TECHMART_CLIENT_SECRET=your-techmart-app-secret
PAYPAL_GADGETHUB_CLIENT_ID=your-gadgethub-app-client-id
PAYPAL_GADGETHUB_CLIENT_SECRET=your-gadgethub-app-secret
PAYPAL_TECHMARTDEALS_CLIENT_ID=your-techmartdeals-app-client-id
PAYPAL_TECHMARTDEALS_CLIENT_SECRET=your-techmartdeals-app-secret

# Default REST app, used only by scripts/paypal_test.py when no --shop is given
PAYPAL_CLIENT_ID=your-default-app-client-id
PAYPAL_CLIENT_SECRET=your-default-app-secret

# --- LLM (any OpenAI-compatible endpoint) ---
# API key for the LLM provider (Groq in the reference setup)
LLM_API_KEY=your-llm-api-key
# OpenAI-compatible base URL of the provider
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model for the shopping agent, the LLM judge and the intent check
LLM_MODEL=openai/gpt-oss-120b

# --- App ---
# Required for /purchase and /decisions/*; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_ACCESS_KEY=replace-with-a-long-random-string
# Optional: public URL PayPal redirects back to after approval (default http://127.0.0.1:8000)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional: path of the SQLite audit log (default audit.db)
AUDIT_DB_PATH=audit.db
